# Flyx 3.0 Environment Variables
# Copy this file to .env and fill in values

# TMDB API (required for content metadata)
TMDB_API_KEY=

# JWT Secret (required for admin auth and sync)
JWT_SECRET=

# Database (Cloudflare D1 for production, SQLite for local dev)
DATABASE_URL=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Stripe (for token purchases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Discord (for bot integration)
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Host key (for creating accounts — required to enable registration)
HOST_KEY=

# Landing page (set to "false" to disable the landing page)
ENABLE_LANDING_PAGE=true

# Disable browser/puppeteer fallbacks (pure fetch only, no headless Chrome)
# Set to "true" for production deployments without Chrome/Chromium installed
FLYX_NO_BROWSER=false
