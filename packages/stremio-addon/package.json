{
  "name": "@flyx/stremio-addon",
  "version": "1.0.0",
  "private": true,
  "description": "Private Stremio stream add-on powered by Flyx providers",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@flyx/core": "*",
    "@flyx/extractors": "*",
    "@flyx/providers": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.120.0"
  }
}
